# Settings for running dx.client on this machine (make dev). Copy to .env;
# `make setup` does that. In Docker, infra.dx passes these to the container.
# Everything here ends up in the browser: never put secrets in it.

# dx.server: `make dev` in dx.server, or infra.dx's stack, runs it here.
VITE_API=http://localhost:4200
VITE_ENV_TYPE=dev
VITE_BASE_URL=

VITE_CMS_API='the CMS address'
VITE_CMS_TOKEN='your CMS token'
VITE_AUTH0_DOMAIN='your auth0 tenant app domain'
VITE_AUTH0_CLIENT='your auth0 tenant app client id'
VITE_AUTH0_AUDIENCE='your auth0 tenant app audience'
VITE_GOOGLE_API_CLIENT_ID='your id for the Google Drive integration'
VITE_GOOGLE_API_DEV_KEY='your key for the Google Drive integration'
VITE_INTERCOM_APP_ID='your intercom app id'
VITE_LIVE_SESSION_ID='your livesession id'
